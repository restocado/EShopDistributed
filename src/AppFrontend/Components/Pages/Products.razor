@page "/products"
@inject ICatalogApiClient CatalogApiClient;
@attribute [StreamRendering(true)]
@attribute [OutputCache(Duration = 5)]

<PageTitle>Products</PageTitle>

<h1>Products</h1>

<p>Here are some of our amazing products that you can purchase.</p>

@if (products is null)
{
    <p><em>Loading...</em></p>
}
else if(products.Count() == 0)
{
    <p><em>There is a problem with the product loading. Please try again later.</em></p>
}
else
{
  <table class="table">
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td><img height="80" width="80" src="@product.ImageUrl" /></td>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td>@product.Price</td>
                </tr>
            }
        </tbody>
  </table>   
}

@code {
    IEnumerable<ProductDto>? products;

    protected override async Task OnInitializedAsync()
    {
        products = await CatalogApiClient.GetProductsAsync();
    }
}
