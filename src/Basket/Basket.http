@Basket_HostAddress = https://localhost:7290/basket

### Get basket by username
GET {{Basket_HostAddress}}/john_doe
Accept: application/json

###

### Upsert (create/update) basket
POST {{Basket_HostAddress}}/
Content-Type: application/json
Accept: application/json

{
  "userName": "john_doe",
  "items": [
    {
      "productId": 1,
      "productName": "Laptop",
      "quantity": 1,
      "price": 55000.00
    }
  ]
}

###

### Upsert (create/update) basket
POST {{Basket_HostAddress}}/
Content-Type: application/json
Accept: application/json

{
  "userName": "john_doe",
  "items": [
    {
      "productId": 1,
      "productName": "Laptop",
      "quantity": 1,
      "price": 55000.00
    },
    {
      "productId": 2,
      "productName": "Mouse",
      "quantity": 2,
      "price": 500.00
    }
  ]
}

###

### Delete basket by username
DELETE {{Basket_HostAddress}}/john_doe
Accept: application/json
